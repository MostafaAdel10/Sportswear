{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ConnectionStrings": {
    "cs": "Server=.;Database=Sportswear;User Id ='sa';Password=sa123456;TrustServerCertificate=True;"
  },

  "jwtSettings": {
    "secret": "SportswearProjectCleanArchitectureKey",
    "issuer": "SportswearProject",
    "audience": "WebSite",
    "validateAudience": true,
    "validateIssuer": true,
    "validateLifetime": true,
    "validateIssuerSigningKey": true,
    "AccessTokenExpireDate": 1,
    "RefreshTokenExpireDate": 20
  },
  "emailSettings": {
    "port": "465",
    "host": "smtp.gmail.com",
    "FromEmail": "",
    "password": ""
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "ApplicationName": "Sportswear.Api"
    }
  },

  "FileUpload": {
    "UploadRoot": "wwwroot/images",
    "BaseUrl": "/images",
    "MaxFileSizeMb": 10
  },

  "Cors": {
    "AllowAll": true,
    "AllowedOrigins": [
    ]
  }
}
